#usda 1.0
(
    defaultPrim = "World"
)

def Xform "World"
{
    def Xform "Chair_01" (
        instanceable = true
        prepend references = @./assets/chair.usd@
    )
    {
        double3 xformOp:translate = (-1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "Chair_02" (
        instanceable = true
        prepend references = @./assets/chair.usd@
    )
    {
        double3 xformOp:translate = (1, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
